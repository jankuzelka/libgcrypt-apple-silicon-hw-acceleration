 cipher/sm3-armv8-aarch64-ce.S        |   8 +-
 cipher/sm4-aarch64.S                 |  40 ++++----
 cipher/sm4-armv8-aarch64-ce.S        |  56 +++++------
 cipher/sm4-armv9-aarch64-sve-ce.S    |  40 ++++----
 cipher/twofish-aarch64.S             |  16 ++--
 15 files changed, 204 insertions(+), 204 deletions(-)

diff --git a/cipher/asm-poly1305-aarch64.h b/cipher/asm-poly1305-aarch64.h
index 2f05aae..04dcd4a 100644
